[Unit]
Description=boxd B0 · RAV3N main registered health adapter
After=network.target
Wants=network.target

StartLimitIntervalSec=90
StartLimitBurst=4

[Service]
Type=simple
WorkingDirectory=/home/anu/PAN7HEON/7HE.RAV3N
ExecStart=/home/anu/.asdf/installs/elixir/1.18.6-otp-27/bin/elixir /home/anu/.local/share/boxd/b0.exs b0 run --rav3n-main /home/anu/PAN7HEON/7HE.RAV3N/RAV3N.ID /home/anu/_TRON/sysgen/registry/v1/seats.kdl
Environment=HOME=/home/anu
Environment=PATH=/home/anu/.asdf/installs/elixir/1.18.6-otp-27/bin:/home/anu/.asdf/installs/erlang/27.3.4.6/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target