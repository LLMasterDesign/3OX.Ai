{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://3ox.ai/meta/encoder.receipt.v1.json",
  "title": "ENCODER_RECEIPT_V1",
  "description": "Layer 6 receipt: extends Pulse job log shape with encoder MAP resolution. Aligns with .3ox/run.rb result keys.",
  "type": "object",
  "required": [
    "receipt_version",
    "job_id",
    "completed_at",
    "status",
    "encoder"
  ],
  "properties": {
    "receipt_version": {
      "type": "string",
      "const": "1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "description": "ISO8601 UTC"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed"]
    },
    "output_preview": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional; same as Pulse run_job result"
    },
    "encoder": {
      "type": "object",
      "required": ["layer_6_receipt", "code_4096", "map"],
      "properties": {
        "layer_6_receipt": {
          "type": "boolean",
          "const": true
        },
        "dry_run": {
          "type": "boolean",
          "description": "True when produced by encoder_dry_run.py without executing a Pulse job"
        },
        "code_4096": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{3}$"
        },
        "map": {
          "type": "object",
          "description": "Resolved MAP: hex row + slot_index entry + route keys",
          "properties": {
            "hex_entry": { "type": "object" },
            "slot_id": { "type": "string" },
            "slot_row": {},
            "route_keys": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "tape_relative_path": {
          "type": "string",
          "description": "Path under Pulse runtime where this receipt was appended to TAPE"
        }
      }
    }
  },
  "additionalProperties": true
}
