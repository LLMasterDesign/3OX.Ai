# doc:[COMPLETE] modified:[26.05.04] auth:[ZEN.PRO]
# Runs the TPR handoff consumer every 5s, with a 30s safety boot delay.
[Unit]
Description=TPR handoff consumer (periodic)

[Timer]
OnBootSec=30s
OnUnitActiveSec=5s
Unit=tpr-handoff.service
AccuracySec=1s

[Install]
WantedBy=timers.target
