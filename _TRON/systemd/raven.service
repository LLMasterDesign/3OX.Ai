# Raven Suite supervisor for 3OX.Sidekik — edge-triggered.
#
# Triggered by raven.path when an intent lands in .raven/inbox.
# Type=oneshot so each edge maps to exactly one drain pass. NO timer.
# NO Restart=always loop. The rotor (TPW.SPIN, hex 0x003 / k00) is
# the clock; we ride its Pulse edge (k02 / hex 0x002).
[Unit]
Description=Raven Suite supervisor (3OX.Sidekik) — edge-triggered, oneshot
After=network-online.target
Wants=network-online.target
PartOf=raven.path

[Service]
Type=oneshot
WorkingDirectory=/root/_TRON/Agents/Sidekik
ExecStart=/usr/bin/env ruby raven.rb tick
Environment=SIDEKIK_OPERATOR=lucius
StandardOutput=append:/root/_TRON/Agents/Sidekik/.3ox/(6)Pulse/runtime/logs/raven.log
StandardError=append:/root/_TRON/Agents/Sidekik/.3ox/(6)Pulse/runtime/logs/raven.log
