# Raven Suite supervisor for 3OX.Sidekik (CMD.VPS / WSL).
# Install: copy to /etc/systemd/system/raven.service, edit paths, daemon-reload.
[Unit]
Description=Raven Suite supervisor (3OX.Sidekik)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/_TRON/Agents/Sidekik
ExecStart=/usr/bin/env ruby raven.rb tick
Restart=always
RestartSec=5
Environment=RAVEN_INTERVAL=5
Environment=SIDEKIK_OPERATOR=lucius
StandardOutput=append:/root/_TRON/Agents/Sidekik/.3ox/(6)Pulse/runtime/logs/raven.log
StandardError=append:/root/_TRON/Agents/Sidekik/.3ox/(6)Pulse/runtime/logs/raven.log

[Install]
WantedBy=multi-user.target
