# status:[ACTIVE] ver:[0.1.0] created:[26.05.04]
# Runtime ephemera — never commit per-host pulse / tape / inbox / outbox state.

# Root cube runtime
.3ox/(6)Pulse/runtime/
**/.3ox/(6)Pulse/runtime/

# Raven Suite live state (per agent cube)
**/.raven/inbox/*
**/.raven/outbox/*
**/.raven/tape/*
!**/.raven/inbox/.gitkeep
!**/.raven/outbox/.gitkeep
!**/.raven/tape/.gitkeep

# TPR fragments are emitted on every teleprompt; keep the dir, ignore the JSON.
**/!0UT.SIDEKIK/tpr/*.json
**/!0UT.SIDEKIK/tpr/handoff/*
!**/!0UT.SIDEKIK/tpr/.gitkeep
!**/!0UT.SIDEKIK/tpr/handoff/.gitkeep

# Pid files / logs
*.pid
*.log

# Cargo build artifacts (Cargo.lock is intentionally tracked for binary crates)
**/target/
