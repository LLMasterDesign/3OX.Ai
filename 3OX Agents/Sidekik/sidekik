#!/usr/bin/env bash
# status:[ACTIVE] ver:[0.3.0] created:[26.05.04]
# doc:[COMPLETE] modified:[26.05.04] auth:[ZEN.PRO]
# sidekik — friendly CLI front for 3OX.Sidekik (Raven Suite).
#
# Edge-only. NO daemon. NO polling. The rotor is the clock — TPW.SPIN
# (hex 0x003 / k00) drives Pulse (k02) edges. Each command here
# triggers exactly one edge.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PULSE="$HERE/.3ox/(6)Pulse/run.rb"
RAVEN="$HERE/raven.rb"

case "${1:-help}" in
  say)
    shift; ruby "$PULSE" triage "$@"; ruby "$PULSE" dispatch; ruby "$PULSE" status ;;
  note)            shift; ruby "$PULSE" note "$@" ;;
  status)          ruby "$PULSE" status ;;
  teleprompt|tpr)  ruby "$PULSE" teleprompt ;;
  sync)            bash "$HERE/sync-vps.sh" ;;
  tick|edge|once)  ruby "$RAVEN" tick ;;
  alive)           ruby "$RAVEN" aliveness ;;
  help|*)
    cat <<EOF
sidekik — Raven Suite CLI (edge-only, no clocks)

  say "<intent>"        triage + dispatch + status
  note "<text>"         append to tape
  status                snapshot
  teleprompt | tpr      regenerate TPR speaker + route fragments
  sync                  rsync to VPS, run TPR merge, restart speaker-mesh
  tick | edge | once    fire one rotor edge (dispatch + status)
  alive                 local Box-aliveness check

The rotor (TPW.SPIN) is the clock. Background supervisors and timers
were removed — every action is one edge. Wire automatic edges via the
systemd path-unit pair: raven.path (PathChanged=.raven/inbox) →
raven.service (Type=oneshot).

TPR (TelePromptR) is the only Telegram speaker. Agents emit
TPR.SPEAKER.MESH.json + TPR.ROUTE.MAP.json fragments and let TPR's
merge.sh fold them into the master config on the VPS.
EOF
    ;;
esac
