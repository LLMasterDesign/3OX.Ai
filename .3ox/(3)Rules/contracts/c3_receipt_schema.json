{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3ox.ai/contracts/c3_receipt_schema.json",
  "title": "C3 Receipt Schema (stub)",
  "description": "Minimal receipt envelope; align with _meta/ENCODER.RECEIPT.schema.json when promoted.",
  "type": "object",
  "required": ["event", "status", "hex_code"],
  "properties": {
    "event": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "fail", "fallback"] },
    "hex_code": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{3}$" },
    "fields": { "type": "object" },
    "proof_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
