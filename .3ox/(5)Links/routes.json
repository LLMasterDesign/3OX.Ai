{
  "agent": "AGENT_NAME",
  "version": "1.0.0",
  "links": {
    "map_toml": "map.toml",
    "slot_index_kdl": "slot.index.kdl"
  },
  "inference_serving": {
    "mode": "single_slot",
    "policy": "resolve_slot_then_read_slot_scope_only",
    "omit_context": ["full_pipeline_watch", "cross_slot_live_stream"]
  },
  "gensing": {
    "lex_anchor": {
      "status": "draft_options_not_approved",
      "role": "doc_key_for_index_lookup_before_bulk_body",
      "token_count_rule": "whitespace_delimited_segments_brackets_and_colon_runs_count_as_segments",
      "placement_suggestion": "banner_line_1_trailing",
      "examples_2_tokens": [
        "[0xA4] ::",
        ":: v1",
        "〘TGX〙 κ",
        "[E042] ξ"
      ],
      "examples_3_tokens": [
        ":: [0xA4] ::",
        "[EXC.v1] :: κ",
        "〘0xA4〙 :: φ",
        ":: [k00] κ"
      ],
      "examples_4_tokens": [
        ":: [0xA4] :: κ",
        ":: [TPW.w1] :: ξ",
        "[ENC.v1] :: :: ρ",
        "〘0xA4〙 :: E042 κ"
      ]
    },
    "layers": {
      "gensing": "eternal_readable_law_headers_first",
      "kdl": "precompile_index",
      "elixir": "runtime_only_when_spec_points_source_not_encoder_bulk"
    },
    "markers": {
      "exc_cell": "ξ [EXC] ::"
    }
  },
  "slot_index": {
    "k00": {
      "name": "KERNEL.RESERVE",
      "class": "κ"
    },
    "E042": {
      "name": "ETRIOS.CORE",
      "class": "ξ",
      "route_key": "etrios.core"
    }
  },
  "maps": {
    "trigger": {},
    "intent": {
      "etrios.core": "E042"
    },
    "command": {}
  },
  "routes": {
    "telegram": {
      "chat_id": null,
      "thread_id": null
    },
    "mesh": {
      "speaker": "speaker-mesh",
      "config": "TPR.SPEAKER.MESH.json"
    },
    "etrios.core": {
      "slot": "E042",
      "description": "example route bound to entity slot E042"
    }
  }
}
