  "exc_boundary": {
    "handoff_version": "research-v1",
    "definition": "EXC_is_non_executing_boundary_one_bounded_replayable_unit",
    "semantic_tuple": {
      "EXC": [
        "id",
        "PHENO",
        "PiCO",
        "PRISM",
        "\u039e",
        "\u03bd",
        "\u03c0_optional"
      ],
      "PHENO": [
        "\u03c1",
        "\u03c6",
        "\u03c4"
      ],
      "PiCO": [
        "\u22a2",
        "\u21e8",
        "\u27ff",
        "\u25b7"
      ],
      "pi_note": "\u03c0_reserved_optional_lower_control_v1_absence_does_not_invalidate"
    },
    "surfaces_one_identity": {
      "law": "1_EXC_identity_=_1_.exc_+_1_.kdl_+_1_.exs_not_weighted_triple",
      "exc": {
        "role": "canonical_truth_human_llm_source",
        "may_redefine_meaning": false
      },
      "kdl": {
        "role": "deterministic_structural_skeleton_parser_mirror",
        "may_redefine_meaning": false,
        "generation": "mechanical_from_exc_or_proven_equivalent_only"
      },
      "exs": {
        "role": "replaceable_execution_validates_against_boundary",
        "may_redefine_meaning": false
      },
      "dominance": "if_kdl_or_exs_diverges_from_exc_then_exc_wins"
    },
    "invariants_v1": [
      "boundary_identity_id_present",
      "PHENO_complete_ordered_rho_phi_tau",
      "PiCO_complete_ordered_ingest_validate_carry_emit",
      "PRISM_literal_PRISM",
      "Xi_fixed_verify_source_revalidate_rho_phi_tau",
      "nu_present_with_body",
      "token_bodies_single_line_opaque_placement_validated_not_inner_domain"
    ],
    "validation_outcomes": {
      "PASS": "all_core_checks_true",
      "FALLBACK": "core_failed_but_nu_present_explicit_degraded",
      "FAIL": "core_failed_and_nu_absent_or_unusable"
    },
    "replay": {
      "same_canonical_exc_same_validator_impl": "receipt_equality_expected",
      "same_canonical_exc_different_validator_or_impl": "boundary_equal_receipt_not_guaranteed"
    },
    "wire_and_packages": {
      "note": "grpc_exc_proto_and_excR_package_are_out_of_tree_place_inst_proto_when_added",
      "map_toml_keys": [
        "proto_spec_hint",
        "exc_runtime_faces_hint"
      ]
    },
    "slot_index_research_placeholder": {
      "note": "handoff_used_1_to_216_receipt_slot_align_with_xi_E000_E215_or_hex_codebook_separately",
      "global_key": "exc_id_primary_routing_coordinate_slot_index_secondary"
    }
  },
  "inference_serving": {
    "mode": "single_slot",
    "policy": "resolve_slot_then_read_slot_scope_only",
    "omit_context": [
      "full_pipeline_watch",
      "cross_slot_live_stream"
    ]
  },
  "gensing": {
    "lex_anchor": {
      "status": "draft_lucius_banner_spine_hex_only_in_code_slot",
      "role": "doc_key_for_index_lookup_before_bulk_body",
      "banner_line_1": {
        "spine": "///\u2599\u2596\u2599\u2596\u259e\u259e\u2599\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582\u2582 ::0xHHH::",
        "note": "glyph_row_then_::0xHHH::_three_hex_digits_after_0x_always_12bit_codebook"
      },
      "colon_switch": {
        "meaning": "focus_phase_delimiter_not_free_whitespace",
        "pattern": "Banner :: HexSlot :: end_of_hex_banner_region",
        "brackets_optional": true,
        "comment": "experimented_with_::_[_hex_]_::_bracketed_form_may_drop_if_redundant"
      },
      "hex_slot_rules": {
        "alphabet_in_code_only": "0123456789abcdefABCDEFx",
        "no_mnemonic_words_inside_hex_token": true,
        "canonical_chip": "::0xHHH::",
        "digits_after_0x": 3,
        "leading_zero_pad": true,
        "range_inclusive": [
          "0x000",
          "0xFFF"
        ],
        "distinct_codes": 4096,
        "line_1_never": [
          "wrong_digit_count_after_0x",
          "ten_or_more_spaced_hex_as_first_line",
          "non_hex_letters_G_H_K_in_chip"
        ],
        "line_1_always": [
          "glyph_spine_dominant_future_aesthetic",
          "closed_::_delimiters_parse_safe",
          "exactly_three_hex_digits_in_chip"
        ],
        "full_precision_lookup": "hex_index_json_only_merge_claims_there",
        "examples_valid_line_1": [
          "0x000",
          "0x02A",
          "0x0A4",
          "0xFFF"
        ],
        "examples_invalid": [
          "0xTGX",
          "0x42",
          "0xA4F2",
          "0xG5H",
          "k00_in_hex_slot"
        ]
      },
      "reuse_theme": "fixed_spine_change_hex_only_for_10000_plus_docs",
      "glyph_density": "prefer_no_blank_space_visual_rhythm_glyphs_carry_semantics",
      "context_line": {
        "role": "fleet_triple_not_in_banner_hex_use_this_line",
        "pattern": "\u2af8 \u3014runtime.binding.context\u3015",
        "binding": "replace_runtime_binding_context_with_bracketed_triple",
        "triple_slots_in_brackets": {
          "capacity": "243_per_box_27_kappa_plus_216_xi_when_split",
          "form_examples": [
            "\u2af8 \u3014\u03a99f2a\u3015\u3014\u03bak00\u3015\u3014\u03beE042\u3015",
            "\u2af8 \u3014\u03a99f2a\u3015\u3014\u03bak12\u3015\u3014\u03beE000\u3015",
            "\u2af8 \u3014\u03a99f2a\u3015\u3014\u03beE215\u3015"
          ],
          "bracket_rule": "each_segment_one_meaning_seal_kind_slot_no_english_in_seals_use_hex_or_slot_ids"
        },
        "note": "banner_line_1_hex_stays_hex_alphabet_only_triple_disambiguates_themed_3ox_agents"
      },
      "codebook_4096": {
        "role": "static_address_space_all_work_sparse_claims_in_hex_index_json",
        "index_file": "hex.index.json",
        "banner_chip": {
          "pattern": "::0xHHH::",
          "bits": 12,
          "count": 4096
        },
        "row_contract": {
          "chip_in_doc": "bare_minimum_::0xHHH::_on_line_1_only",
          "metadata": "lives_in_hex_index_entries_and_elsewhere_never_in_chip",
          "real_time_validation": "parse_chip_then_lookup_entries_if_claimed_expect_minimal_row"
        }
      }
    },
    "layers": {
      "gensing": "eternal_readable_law_headers_first",
      "exc": "canonical_boundary_text_normative_separate_from_chip_metadata",
      "kdl": "precompile_index_derived_from_exc_when_applicable",
      "elixir": "runtime_only_when_spec_points_source_not_encoder_bulk"
    },
