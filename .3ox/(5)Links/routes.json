{
  "agent": "AGENT_NAME",
  "version": "1.0.0",
  "links": {
    "map_toml": "map.toml",
    "slot_index_kdl": "slot.index.kdl"
  },
  "inference_serving": {
    "mode": "single_slot",
    "policy": "resolve_slot_then_read_slot_scope_only",
    "omit_context": ["full_pipeline_watch", "cross_slot_live_stream"]
  },
  "gensing": {
    "lex_anchor": {
      "status": "draft_lucius_banner_spine_hex_only_in_code_slot",
      "role": "doc_key_for_index_lookup_before_bulk_body",
      "banner_line_1": {
        "spine": "///▙▖▙▖▞▞▙▂▂▂▂▂▂▂▂▂▂▂▂▂▂ ::[HEX]::",
        "note": "glyph_row_then_::[hex]::_closes_lex_anchor_same_line"
      },
      "colon_switch": {
        "meaning": "focus_phase_delimiter_not_free_whitespace",
        "pattern": "Banner :: HexSlot :: end_of_hex_banner_region",
        "brackets_optional": true,
        "comment": "experimented_with_::_[_hex_]_::_bracketed_form_may_drop_if_redundant"
      },
      "hex_slot_rules": {
        "alphabet_in_code_only": "0123456789abcdefABCDEFx",
        "no_mnemonic_words_inside_hex_token": true,
        "line_1_hex_max_digits": 4,
        "line_1_never": [
          "ten_or_more_spaced_hex_as_first_line",
          "long_packed_id_as_banner_chip"
        ],
        "line_1_always": [
          "glyph_spine_dominant_future_aesthetic",
          "closed_::_delimiters_parse_safe",
          "tiny_lex_chip_only_between_outer_::"
        ],
        "full_precision_lookup": "routes_json_slot_index_kdl_machine_row_not_first_line_banner",
        "examples_valid_line_1": ["0xA4", "A4", "00", "0x1F"],
        "examples_invalid": ["0xTGX", "TPW", "ENC.v1", "k00_in_hex_slot", "DEADBEEF_on_line_1_chip"]
      },
      "reuse_theme": "fixed_spine_change_hex_only_for_10000_plus_docs",
      "glyph_density": "prefer_no_blank_space_visual_rhythm_glyphs_carry_semantics",
      "context_line": {
        "role": "fleet_triple_not_in_banner_hex_use_this_line",
        "pattern": "⫸ 〔runtime.binding.context〕",
        "binding": "replace_runtime_binding_context_with_bracketed_triple",
        "triple_slots_in_brackets": {
          "capacity": "243_per_box_27_kappa_plus_216_xi_when_split",
          "form_examples": [
            "⫸ 〔Ω9f2a〕〔κk00〕〔ξE042〕",
            "⫸ 〔Ω9f2a〕〔κk12〕〔ξE000〕",
            "⫸ 〔Ω9f2a〕〔ξE215〕"
          ],
          "bracket_rule": "each_segment_one_meaning_seal_kind_slot_no_english_in_seals_use_hex_or_slot_ids"
        },
        "note": "banner_line_1_hex_stays_hex_alphabet_only_triple_disambiguates_themed_3ox_agents"
      },
      "banner_hex_top_three": {
        "note": "these_are_registry_or_row_encodings_not_the_visual_first_line_chip",
        "options": [
          {
            "id": "packed_16",
            "encoding": "0xHHLL",
            "meaning": "high_byte_agent_ordinal_low_byte_slot_0_to_242",
            "token_weight": 2,
            "fleet_strength_100": 78,
            "where_to_store": "routes_maps_machine_index_footer_optional"
          },
          {
            "id": "packed_20",
            "encoding": "0xHHHHH",
            "meaning": "flat_global_id_agent12bit_times_243_plus_slot",
            "token_weight": 2,
            "fleet_strength_100": 88,
            "where_to_store": "routes_maps_machine_index_footer_optional"
          },
          {
            "id": "packed_24",
            "encoding": "0xHHHHHH",
            "meaning": "flat_id_plus_headroom_kappa_xi_or_version_bits",
            "token_weight": 3,
            "fleet_strength_100": 90,
            "where_to_store": "routes_maps_machine_index_footer_optional"
          }
        ]
      }
    },
    "layers": {
      "gensing": "eternal_readable_law_headers_first",
      "kdl": "precompile_index",
      "elixir": "runtime_only_when_spec_points_source_not_encoder_bulk"
    },
    "markers": {
      "exc_cell": "ξ [EXC] ::"
    }
  },
  "slot_index": {
    "k00": {
      "name": "KERNEL.RESERVE",
      "class": "κ"
    },
