      "forms": ["0xNN", "0xNNNN", "::[NAME.vN]::", "〘0xTAG〙"],
      "placement": "banner_line_1_trailing",
      "note": "not_required_hex_any_short_stable_key_under_4_tokens"
    },
    "layers": {
      "gensing": "eternal_readable_law_headers_first",
      "kdl": "precompile_index",
      "elixir": "runtime_only_when_spec_points_source_not_encoder_bulk"
    },
    "markers": {
      "exc_cell": "ξ [EXC] ::"
    }
  },
  "slot_index": {
    "k00": {
      "name": "KERNEL.RESERVE",
      "class": "κ"
    },
    "E042": {
      "name": "ETRIOS.CORE",
      "class": "ξ",
      "route_key": "etrios.core"
    }
  },
  "maps": {
    "trigger": {},
    "intent": {
      "etrios.core": "E042"
    },
    "command": {}
  },
  "routes": {
    "telegram": {
      "chat_id": null,
      "thread_id": null
    },
    "mesh": {
      "speaker": "speaker-mesh",
      "config": "TPR.SPEAKER.MESH.json"
    },
    "etrios.core": {
      "slot": "E042",
      "description": "example route bound to entity slot E042"
    }
  }
