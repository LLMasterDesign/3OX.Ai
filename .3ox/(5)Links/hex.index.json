{
  "codebook_version": "1",
  "codebook_bits": 12,
  "codebook_size": 4096,
  "chip": {
    "banner_form": "::0xHHH::",
    "key_regex": "^0x[0-9A-Fa-f]{3}$",
    "leading_zero_pad": true,
    "range_inclusive": ["0x000", "0xFFF"]
