      "exc_id",
      "exc_surfaces",
      "validator_version",
      "impl_version"
    ],
    "exc_surfaces_shape": {
      "exc": "path_or_uri_to_canonical_exc",
      "kdl": "path_to_derived_kdl",
      "exs": "path_to_runtime_implementation"
    }
  },
